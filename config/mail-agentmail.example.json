{
  "bus": {
    "installation_id": "home",
    "producer_id": "mail-agentmail",
    "hub_endpoint": "127.0.0.1:18790",
    "token_file": "mail-agentmail.token",
    "zones": ["home-lan"],
    "capabilities": ["mail.bridge"],
    "screen_anchors": [],
    "schema_version": 2,
    "read_timeout_ms": 10000
  },
  "account": {
    "schema_version": 1,
    "account_id": "mail-agentmail",
    "protocol": "imap",
    "host": "imap.agentmail.to",
    "port": 993,
    "tls": true,
    "username": "myinbox@agentmail.to",
    "credential_ref": "geode://agentmail/inbox/api-key",
    "folders": ["INBOX"],
    "poll_interval_ms": 30000,
    "capabilities": {
      "push": false,
      "folders": true,
      "flags": true,
      "delete": true,
      "uidl": false
    }
  },
  "publish_metadata": false,
  "batch_size": 64,
  "initial_max": 64
}
