# User unit; enable lingering so the TV service survives logout and reboot.
[Unit]
Description=Unibus HDHomeRun LAN discovery and playback proxy
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/unibus-hdhomerun %h/.config/unibus-hdhomerun/proxy.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=default.target
