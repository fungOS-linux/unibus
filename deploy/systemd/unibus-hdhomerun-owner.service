[Unit]
Description=Unibus private HDHomeRun tuner endpoint
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
DynamicUser=yes
LoadCredential=ca.pem:/etc/unibus-hdhomerun/ca.pem
LoadCredential=peer.pem:/etc/unibus-hdhomerun/peer.pem
LoadCredential=peer.key:/etc/unibus-hdhomerun/peer.key
LoadCredential=owner.json:/etc/unibus-hdhomerun/owner.json
ExecStart=/usr/local/bin/unibus-hdhomerun /run/credentials/unibus-hdhomerun-owner.service/owner.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
